              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/1000-BANK/balance?asOf=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "1000-BANK", "balance"],
