      "key": "tenantId",
      "value": "acme-corp",
      "type": "string"
    },
    {
      "key": "webhookSecret",
      "value": "super-secret-shared-key-2026",
      "type": "string"
    },
    {
      "key": "journalEntryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Journal Entries",
      "item": [
        {
          "name": "Create Balanced Journal Entry (Success 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Debits equal Credits\", function () {",
                  "    pm.expect(jsonData.totalDebits).to.eql(jsonData.totalCredits);",
                  "});",
                  "",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"journalEntryId\", jsonData.id);",
                  "    console.log(\"Saved journalEntryId:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entryDate\": \"2026-10-12\",\n  \"description\": \"Invoice payment received from Acme Client\",\n  \"lines\": [\n    {\n      \"accountCode\": \"1000-BANK\",\n      \"amount\": 5000.00,\n      \"direction\": \"DEBIT\"\n    },\n    {\n      \"accountCode\": \"4000-SALES\",\n      \"amount\": 5000.00,\n      \"direction\": \"CREDIT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries"]
            },
            "description": "Creates a balanced double-entry journal record. Automatically extracts and stores the returned entry ID into {{journalEntryId}} for subsequent requests."
          }
        },
        {
          "name": "Create Unbalanced Journal Entry (Rejected 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Error message indicates unbalanced entry\", function () {",
                  "    pm.expect(jsonData.error).to.include(\"Journal entry is unbalanced\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entryDate\": \"2026-10-12\",\n  \"description\": \"Intentional unbalanced test entry\",\n  \"lines\": [\n    {\n      \"accountCode\": \"1000-BANK\",\n      \"amount\": 5000.00,\n      \"direction\": \"DEBIT\"\n    },\n    {\n      \"accountCode\": \"4000-SALES\",\n      \"amount\": 4000.00,\n      \"direction\": \"CREDIT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries"]
            },
            "description": "Tests double-entry domain validation invariant: debits != credits returns 400 Bad Request."
          }
        },
        {
          "name": "List Journal Entries (Filtered & Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries?from=2026-01-01&to=2026-12-31&page=0&size=20&sort=entryDate,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "entryDate,desc" }
              ]
            },
            "description": "Lists journal entries for the current tenant with optional date filtering and pagination."
          }
        },
        {
          "name": "Get Journal Entry by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Entry ID matches requested ID\", function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get(\"journalEntryId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries/{{journalEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries", "{{journalEntryId}}"]
            },
            "description": "Fetches a specific journal entry by UUID within the active tenant."
          }
        },
        {
          "name": "Reverse Journal Entry (Success 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Reversal links to original entry\", function () {",
                  "    pm.expect(jsonData.reversalOfEntryId).to.eql(pm.collectionVariables.get(\"journalEntryId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries/{{journalEntryId}}/reverse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries", "{{journalEntryId}}", "reverse"]
            },
            "description": "Creates an offsetting reversal entry swapping debits and credits, bringing the account balance back to zero."
          }
        },
        {
          "name": "Reverse Journal Entry Second Time (Rejected 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Error indicates already reversed\", function () {",
                  "    pm.expect(jsonData.error).to.include(\"has already been reversed\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal-entries/{{journalEntryId}}/reverse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal-entries", "{{journalEntryId}}", "reverse"]
            },
            "description": "Enforces Section 3.4 Double-Reversal rule: an entry cannot be reversed more than once."
          }
        }
      ]
    },
    {
      "name": "2. Accounts & Balances",
      "item": [
        {
          "name": "Get Bank Account Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response has accountCode and tenantId\", function () {",
                  "    pm.expect(jsonData.accountCode).to.eql(\"1000-BANK\");",
                  "    pm.expect(jsonData.tenantId).to.eql(pm.collectionVariables.get(\"tenantId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/1000-BANK/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "1000-BANK", "balance"]
            },
            "description": "Calculates real-time net account balance (Debits - Credits) for the specified account code."
          }
        },
        {
          "name": "Get Account Balance asOf Date",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
